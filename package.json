{
  "name": "aihot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "industry"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "npm run dev -w @aihot/api",
    "dev:worker": "npm run dev -w @aihot/worker",
    "dev:web": "npm run dev -w @aihot/web",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && npm run typecheck -w @aihot/web",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/*.test.ts\"",
    "build": "npm run build -w @aihot/web && node sites/build.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260926.1-alpha",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
